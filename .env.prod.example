# ============================================================
# AtléticaHub — variáveis de PRODUÇÃO
# No Portainer: cole o docker-stack.yml e preencha estas variáveis em
# "Environment variables" (Add an environment variable) — uma a uma.
# NUNCA commite este arquivo preenchido (o .gitignore já bloqueia).
# Gere os segredos:  openssl rand -hex 32   (o AES precisa de 64 hex chars)
# ============================================================

# Domínio do site (aponte o registro A do DNS pro IP da VPS)
DOMAIN=atletica.seudominio.com.br

# Banco / storage — senhas fortes (sem @ : / pra não quebrar a DATABASE_URL)
POSTGRES_PASSWORD=troque_esta_senha_forte
MINIO_PASSWORD=troque_esta_senha_forte

# Segredos do app (openssl rand -hex 32 pra cada; AES = 64 hex chars)
JWT_SECRET=
JWT_REFRESH_SECRET=
AES_ENCRYPTION_KEY=
DOCUMENT_HASH_PEPPER=

# E-mail (Gmail com senha de app da atlética)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cyberatletica@gmail.com
SMTP_PASS=
SMTP_FROM=A.A.A.S.I. Cyber <cyberatletica@gmail.com>
