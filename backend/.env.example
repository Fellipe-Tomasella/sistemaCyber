# AtléticaHub backend — copie para .env e ajuste
NODE_ENV=development
PORT=3000

# Postgres (fora do Docker use localhost:5434)
DATABASE_URL=postgresql://atletica:atletica@localhost:5434/atletica_hub

# Segredos — gere com: openssl rand -hex 64 / -hex 32
JWT_SECRET=troque_por_openssl_rand_hex_64
JWT_REFRESH_SECRET=troque_por_openssl_rand_hex_64
AES_ENCRYPTION_KEY=troque_por_openssl_rand_hex_32_64chars
DOCUMENT_HASH_PEPPER=troque_por_min_32_chars_aleatorios

ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=7

# Seed demo
SEED_ATLETICA_NAME=A.A.A.S.I. Cyber
SEED_ATLETICA_SLUG=cyber
SEED_ADMIN_EMAIL=presidente@cyber.demo
SEED_ADMIN_PASSWORD=Atletica@2026!

# Infra
REDIS_URL=redis://localhost:6381
MINIO_ENDPOINT=http://localhost:9200
MINIO_ACCESS_KEY=atletica
MINIO_SECRET_KEY=atletica123
MINIO_BUCKET=atletica-hub

CORS_ORIGIN=*
