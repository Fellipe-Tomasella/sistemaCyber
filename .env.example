# ── E-mail (SMTP do Gmail da atlética) ──
# 1) Ative a verificação em 2 etapas na conta Google da atlética.
# 2) Gere uma "Senha de app" em https://myaccount.google.com/apppasswords (16 dígitos).
# 3) Copie este arquivo para  .env  e preencha abaixo. NUNCA comite o .env.
#
# Depois: docker compose up -d --build backend   (pra recarregar as variáveis)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=cyberatletica@gmail.com
SMTP_PASS=coloque_aqui_a_senha_de_app_de_16_digitos
SMTP_FROM=A.A.A.S.I. Cyber <cyberatletica@gmail.com>
APP_URL=http://localhost:4599
